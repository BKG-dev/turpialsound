// Turpial Sound — Schema de dominio reservas
// Fase 1A.2 — Schema inicial (rev. correctiva 1A.2-b)
// Fuente de verdad: base de datos, no Google Calendar

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum BookingStatus {
  draft
  submitted
  availability_checked
  under_review
  approved_partial
  approved
  rejected
  needs_adjustment
  calendar_booked
  confirmed

  @@map("booking_status")
}

enum UserRole {
  admin
  operations
  casa_director
  turpial_director

  @@map("user_role")
}

enum ApprovalDecision {
  approved
  rejected
  needs_adjustment

  @@map("approval_decision")
}

enum PriorityLevel {
  low
  normal
  high

  @@map("priority_level")
}

// ─────────────────────────────────────────────────────────────────
// SITE COUNTER — persistent visit counter displayed in the footer
// Row id=1 is the single global counter. Upserted on every page load.
// Run `prisma migrate dev` or `prisma db push` after adding this model.
// ─────────────────────────────────────────────────────────────────

model SiteCounter {
  id        Int      @id
  count     Int      @default(81000)
  updatedAt DateTime @updatedAt

  @@map("site_counter")
}

// ─────────────────────────────────────────────────────────────────
// CATÁLOGOS
// ─────────────────────────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ServiceVariant[]

  @@map("services")
}

model ServiceVariant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BookingRequestItem[]

  @@index([serviceId])
  @@map("service_variants")
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items BookingRequestItem[]

  @@map("resources")
}

// ─────────────────────────────────────────────────────────────────
// USUARIOS INTERNOS
// El modelo de auth público se prepara en 1A.5.
// Esta tabla es para el staff y directivos que usan el panel interno.
// ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals Approval[]
  auditLogs AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// DOMINIO RESERVAS
// ─────────────────────────────────────────────────────────────────

model BookingRequest {
  id            String        @id @default(cuid())
  // Código legible para referencia externa (ej: "TUR-2026-001")
  // Se genera al crear la solicitud; se usa en comunicaciones con el cliente.
  publicCode    String        @unique
  status        BookingStatus @default(draft)
  priorityLevel PriorityLevel @default(normal)
  // Origen de la solicitud: "web" | "phone" | "in_person" | "referral" | etc.
  source        String        @default("web")

  // Datos del solicitante (no es un User interno)
  requesterName  String
  requesterEmail String
  requesterPhone String?

  // Datos del evento
  eventTitle   String
  eventDate    DateTime
  eventEndDate DateTime?

  // Notas
  notes         String? // Notas del solicitante (visibles externamente)
  internalNotes String? // Notas internas del equipo (staff only)

  // Estimación económica (opcional; se completa durante revisión interna)
  estimatedTotal Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")

  // Reservado para integración con Google Calendar (fases posteriores)
  calendarEventId String?

  // Timestamps de flujo
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items     BookingRequestItem[]
  approvals Approval[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([eventDate])
  @@index([publicCode])
  @@map("booking_requests")
}

model BookingRequestItem {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id])
  serviceVariantId String
  serviceVariant   ServiceVariant @relation(fields: [serviceVariantId], references: [id])

  // El recurso físico se asigna durante la revisión interna, no al crear la solicitud
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id])

  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingRequestId])
  @@index([serviceVariantId])
  @@map("booking_request_items")
}

// ─────────────────────────────────────────────────────────────────
// APROBACIONES
// Un booking_request puede tener múltiples rondas de aprobación
// (ej: aprobación parcial de operaciones + aprobación final de directivo).
// ─────────────────────────────────────────────────────────────────

model Approval {
  id               String           @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest   @relation(fields: [bookingRequestId], references: [id])
  approverId       String
  approver         User             @relation(fields: [approverId], references: [id])
  // Rol mínimo requerido para este paso de aprobación
  // Permite distinguir aprobación de operaciones vs. aprobación de directivo
  roleRequired     UserRole
  decision         ApprovalDecision
  comment          String?
  // Momento exacto en que se tomó la decisión (puede ser posterior a createdAt)
  decidedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([bookingRequestId])
  @@map("approvals")
}

// ─────────────────────────────────────────────────────────────────
// AUDIT LOG
// Registro inmutable de transiciones de estado y acciones internas.
// previousState / nextState almacenan snapshots en JSON.
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id               String          @id @default(cuid())
  bookingRequestId String?
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  userId           String?
  user             User?           @relation(fields: [userId], references: [id])

  // Acción canónica (ej: "status_changed", "approval_added", "item_updated")
  action        String
  previousState Json?
  nextState     Json?

  createdAt DateTime @default(now())

  @@index([bookingRequestId])
  @@index([createdAt])
  @@map("audit_log")
}

// ═════════════════════════════════════════════════════════════════
// MARKETPLACE DOMAIN (ISOLATED)
// Namespace: Mp (Marketplace)
// Business Isolation: 100% separate from studio booking system
// Shared Infrastructure: Same database, separate tables
// ═════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────
// MARKETPLACE ENUMS
// ─────────────────────────────────────────────────────────────────

enum MpPaymentMethodType {
  MERCANTIL_C2P // Mercantil C2P (Card to Phone)
  MERCANTIL_PAGO_MOVIL // Mercantil Pago Móvil
  MERCANTIL_BOTON_PAGO // Mercantil Botón de Pago
  BINANCE_PAY // Binance Pay API (automated)
  ZELLE // Zelle (manual verification)
  CRYPTO_WALLET_MANUAL // Direct crypto wallet (manual)

  @@map("mp_payment_method_type")
}

enum MpTransactionStatus {
  // Initial States
  INITIATED // User selected payment method
  PENDING_PAYMENT // Awaiting payment confirmation

  // Payment Validation
  PAYMENT_RECEIVED // Payment detected (webhook/manual)
  VALIDATING // Admin reviewing manual payment
  PAYMENT_FAILED // Payment rejected/failed

  // Escrow States
  IN_ESCROW // Funds held, awaiting delivery
  DELIVERY_CONFIRMED // Buyer confirmed receipt

  // Final States
  RELEASED // Funds released to seller
  REFUNDED // Funds returned to buyer
  DISPUTED // Under dispute resolution
  CANCELLED // Transaction cancelled

  @@map("mp_transaction_status")
}

enum MpPayoutMethodType {
  ZELLE // Zelle USD
  PAGO_MOVIL // Pago Móvil VES
  CRYPTO_WALLET // Crypto wallet (USDT, BTC, ETH)
  BANK_TRANSFER // Direct bank transfer

  @@map("mp_payout_method_type")
}

enum MpPayoutStatus {
  PENDING // Awaiting processing
  PROCESSING // Being processed
  COMPLETED // Successfully paid
  FAILED // Payment failed
  CANCELLED // Cancelled by admin

  @@map("mp_payout_status")
}

enum MpDisputeStatus {
  OPEN // Dispute opened
  UNDER_REVIEW // Admin investigating
  RESOLVED_BUYER // Resolved in buyer's favor
  RESOLVED_SELLER // Resolved in seller's favor
  CLOSED // Closed without resolution

  @@map("mp_dispute_status")
}

enum MpListingStatus {
  DRAFT // Being created
  ACTIVE // Published and visible
  PAUSED // Temporarily hidden
  SOLD_OUT // No inventory
  ARCHIVED // Permanently hidden

  @@map("mp_listing_status")
}

enum MpUserRole {
  USER  // Standard marketplace user
  SOCIO // Partner — exempt from platform commission
  SUPER // Developer/admin — full access, exempt from commission

  @@map("mp_user_role")
}

// ─────────────────────────────────────────────────────────────────
// MARKETPLACE USER (BUYER/SELLER PROFILES)
// CRITICAL: This is NOT the internal staff User table
// ─────────────────────────────────────────────────────────────────

model MpUser {
  id String @id @default(cuid())

  // Authentication (will integrate with NextAuth in Phase 2)
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Profile
  displayName String
  bio         String?
  avatarUrl   String?

  // Identity Verification (KYC)
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  verificationLevel String    @default("none") // "none", "basic", "full"

  // Seller-specific fields
  isSeller     Boolean  @default(true)
  sellerRating Decimal? @db.Decimal(3, 2) // 0.00 to 5.00
  totalSales   Int      @default(0)

  // Buyer-specific fields
  totalPurchases Int @default(0)

  // Authentication credential (plain NextAuth integration removes this in Phase 2)
  passwordHash String?

  // Role — SOCIO and SUPER are exempt from platform commission
  role MpUserRole @default(USER)

  // Contact & Notifications
  phone             String?   // e.g. "+58 414 123 4567"
  whatsappConsent   Boolean   @default(false)
  whatsappConsentAt DateTime?

  // Password Reset (token stored as SHA-256 hash; plain token emailed to user)
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Security
  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listings            MpListing[]
  payoutMethods       MpPayoutMethod[]
  buyerTransactions   MpTransaction[]  @relation("MpBuyerTransactions")
  sellerTransactions  MpTransaction[]  @relation("MpSellerTransactions")
  sentMessages        MpMessage[]      @relation("MpMessageSender")
  receivedMessages    MpMessage[]      @relation("MpMessageReceiver")
  chatThreadsAsBuyer  MpChatThread[]   @relation("MpChatBuyer")
  chatThreadsAsSeller MpChatThread[]   @relation("MpChatSeller")
  disputes            MpDispute[]
  mpPayouts           MpPayout[]
  askedQuestions      MpListingQuestion[] @relation("MpAskedQuestions")
  favoriteListings    MpListing[]      @relation("UserFavorites")

  @@index([email])
  @@index([isSeller])
  @@index([isVerified])
  @@index([role])
  @@map("mp_users")
}

// ─────────────────────────────────────────────────────────────────
// PAYOUT METHODS (SELLER WITHDRAWAL CONFIGURATION)
// ─────────────────────────────────────────────────────────────────

model MpPayoutMethod {
  id     String @id @default(cuid())
  userId String
  user   MpUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  methodType MpPayoutMethodType
  isDefault  Boolean            @default(false)
  isActive   Boolean            @default(true)

  // Encrypted sensitive data (use encryption at application level)
  // For Zelle: email
  // For Pago Móvil: phone + bank code + ID
  // For Crypto: wallet address
  encryptedData String // JSON encrypted with app secret

  // Display info (non-sensitive)
  displayLabel String // e.g., "Zelle (****@gmail.com)"
  currency     String // USD, VES, USDT, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mp_payout_methods")
}

// ─────────────────────────────────────────────────────────────────
// LISTINGS (PRODUCTS/SERVICES FOR SALE)
// ─────────────────────────────────────────────────────────────────

model MpListing {
  id       String @id @default(cuid())
  sellerId String
  seller   MpUser @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    String // "beats", "mixing", "mastering", "vocals", etc.
  tags        String[] // Searchable tags

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Media
  coverImageUrl String?
  mediaUrls     String[] // Additional images/audio previews

  // Inventory
  hasInventory Boolean @default(false)
  inventory    Int? // null = unlimited

  status MpListingStatus @default(DRAFT)

  // SEO
  slug String @unique

  // Stats
  viewCount     Int @default(0)
  favoriteCount Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  transactions MpTransaction[]
  questions    MpListingQuestion[]
  favoritedBy  MpUser[]            @relation("UserFavorites")

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([slug])
  @@map("mp_listings")
}

// ─────────────────────────────────────────────────────────────────
// LISTING Q&A (PUBLIC BUYER-FACING QUESTIONS)
// ─────────────────────────────────────────────────────────────────

model MpListingQuestion {
  id        String    @id @default(cuid())
  listingId String
  listing   MpListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId   String
  asker     MpUser    @relation("MpAskedQuestions", fields: [askerId], references: [id], onDelete: Cascade)

  question   String
  answer     String?
  answeredAt DateTime?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([askerId])
  @@map("mp_listing_questions")
}

// ─────────────────────────────────────────────────────────────────
// CHAT THREADS (BUYER-SELLER COMMUNICATION)
// AUDIT REQUIREMENT: Immutable message history
// ─────────────────────────────────────────────────────────────────

model MpChatThread {
  id String @id @default(cuid())

  buyerId String
  buyer   MpUser @relation("MpChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   MpUser @relation("MpChatSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  listingId String? // Optional: may be general inquiry

  // Status
  isActive      Boolean   @default(true)
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MpMessage[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("mp_chat_threads")
}

model MpMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   MpChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   MpUser @relation("MpMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   MpUser @relation("MpMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  content       String
  attachmentUrl String?

  // Audit: Messages are IMMUTABLE (no updates/deletes)
  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("mp_messages")
}

// ─────────────────────────────────────────────────────────────────
// TRANSACTIONS (PAYMENT & ESCROW)
// ─────────────────────────────────────────────────────────────────

model MpTransaction {
  id String @id @default(cuid())

  // Idempotency: Prevents duplicate charges WITHOUT Redis
  // This is a database-level unique constraint
  idempotencyKey String @unique

  // Relationships
  buyerId String
  buyer   MpUser @relation("MpBuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   MpUser @relation("MpSellerTransactions", fields: [sellerId], references: [id])

  listingId String
  listing   MpListing @relation(fields: [listingId], references: [id])

  // Payment Details
  paymentMethod MpPaymentMethodType
  status        MpTransactionStatus @default(INITIATED)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("USD")

  // Platform Fee (calculated at creation)
  platformFeePercent Decimal @db.Decimal(5, 2) // e.g., 10.00 for 10%
  platformFeeAmount  Decimal @db.Decimal(10, 2)
  sellerNetAmount    Decimal @db.Decimal(10, 2)

  // External References
  externalTxId     String? // Mercantil/Binance transaction ID
  paymentReference String? // Zelle reference, wallet hash, etc.
  paymentSenderBank String? // Issuing bank selected by buyer for manual reconciliation
  paymentPaidAt     DateTime? // Reported payment date from buyer
  paymentProofUrl  String? // Screenshot/proof upload URL

  // Escrow Management
  escrowHeldAt    DateTime? // When funds entered escrow
  escrowReleaseAt DateTime? // Scheduled auto-release date (T+7)
  releasedAt      DateTime? // Actual release timestamp

  // Buyer Confirmation (CRITICAL for T+7 flow)
  buyerConfirmedAt DateTime? // When buyer clicked "I received it"

  // Dispute & Notes
  disputeReason   String?
  disputeOpenedAt DateTime?
  adminNotes      String? // Internal notes for manual review

  // Audit Trail
  statusHistory MpTransactionStatusHistory[]
  disputes      MpDispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@index([paymentMethod])
  @@index([externalTxId])
  @@index([paymentReference])
  @@index([paymentSenderBank])
  @@index([paymentPaidAt])
  @@index([idempotencyKey])
  @@map("mp_transactions")
}

// ─────────────────────────────────────────────────────────────────
// TRANSACTION STATUS HISTORY (AUDIT TRAIL)
// ─────────────────────────────────────────────────────────────────

model MpTransactionStatusHistory {
  id            String        @id @default(cuid())
  transactionId String
  transaction   MpTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  fromStatus MpTransactionStatus? // null for initial state
  toStatus   MpTransactionStatus
  changedBy  String? // userId or "SYSTEM" or "WEBHOOK"
  reason     String? // Why the status changed
  metadata   Json? // Additional context (webhook payload, etc.)

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([createdAt])
  @@map("mp_transaction_status_history")
}

// ─────────────────────────────────────────────────────────────────
// DISPUTES (BUYER-SELLER CONFLICTS)
// ─────────────────────────────────────────────────────────────────

model MpDispute {
  id            String        @id @default(cuid())
  transactionId String
  transaction   MpTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  openedById String
  openedBy   MpUser @relation(fields: [openedById], references: [id])

  reason       String
  description  String
  evidenceUrls String[] // Screenshots, files, etc.

  status MpDisputeStatus @default(OPEN)

  // Resolution
  resolvedAt   DateTime?
  resolution   String? // Admin's decision explanation
  refundAmount Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([openedById])
  @@index([status])
  @@map("mp_disputes")
}

// ─────────────────────────────────────────────────────────────────
// PAYOUTS (SELLER WITHDRAWALS)
// ─────────────────────────────────────────────────────────────────

model MpPayout {
  id       String @id @default(cuid())
  sellerId String
  seller   MpUser @relation(fields: [sellerId], references: [id])

  amount   Decimal            @db.Decimal(10, 2)
  currency String
  method   MpPayoutMethodType
  status   MpPayoutStatus     @default(PENDING)

  // Transactions included in this payout
  transactionIds String[] // Array of MpTransaction IDs

  // External payout tracking
  externalPayoutId String? // External payment reference

  // Completion
  completedAt   DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
  @@map("mp_payouts")
}

// ─────────────────────────────────────────────────────────────────
// MARKETPLACE ANALYTICS EVENTS (LIGHTWEIGHT, NON-SENSITIVE)
// ─────────────────────────────────────────────────────────────────

model MpAnalyticsEvent {
  id            String   @id @default(cuid())
  eventType     String
  listingId     String?
  transactionId String?
  userId        String?
  sessionId     String?
  path          String
  referrer      String?
  device        String?
  metadataJson  Json?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([listingId])
  @@index([transactionId])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("mp_analytics_events")
}

// ─────────────────────────────────────────────────────────────────
// MARKETPLACE BLOB METADATA (SAFE STORAGE OBSERVABILITY)
// ─────────────────────────────────────────────────────────────────

model MpBlobObjectMetadata {
  id          String   @id @default(cuid())
  url         String   @unique
  pathname    String?
  sizeBytes   BigInt?
  contentType String?
  entityType  String
  entityId    String?
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
  @@index([entityId])
  @@index([pathname])
  @@index([uploadedAt])
  @@map("mp_blob_object_metadata")
}

// ─────────────────────────────────────────────────────────────────
// BINANCE RATE SNAPSHOTS (MARKETPLACE AUDIT TRAIL)
// ─────────────────────────────────────────────────────────────────

model MpBinanceRateSnapshot {
  id String @id @default(cuid())

  rate       Decimal  @db.Decimal(12, 4)
  fechaValor DateTime

  source String
  mode   String

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fechaValor])
  @@index([createdAt])
  @@index([source])
  @@index([mode])
  @@map("mp_binance_rate_snapshots")
}

// ─────────────────────────────────────────────────────────────────
// WEBHOOK LOGS (SECURITY & DEBUGGING)
// ─────────────────────────────────────────────────────────────────

model MpWebhookLog {
  id            String  @id @default(cuid())
  provider      String // "MERCANTIL", "BINANCE"
  event         String // Event type from webhook
  payload       Json // Full webhook payload
  signature     String? // Webhook signature for verification
  verified      Boolean @default(false)
  processed     Boolean @default(false)
  transactionId String? // Linked transaction if found
  error         String? // Error message if processing failed

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([transactionId])
  @@index([processed])
  @@index([createdAt])
  @@map("mp_webhook_logs")
}
