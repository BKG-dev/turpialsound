## Local-only QA credentials (share real values via secure channel)
QA_BUYER_IDENTIFIER=buyerIA
QA_BUYER_EMAIL=buyerIA@local.test

QA_SELLER_IDENTIFIER=sellerIA
QA_SELLER_EMAIL=sellerIA@local.test

