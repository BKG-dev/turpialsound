# Add QA passwords only in your local .env.local (do not commit)
# QA_BUYER_PASSWORD -> <QA_BUYER_PASSWORD_SECURE_CHANNEL>
# QA_SELLER_PASSWORD -> <QA_SELLER_PASSWORD_SECURE_CHANNEL>
# QA_ADMIN_PASSWORD -> <QA_ADMIN_PASSWORD_SECURE_CHANNEL>

## Optional QA runtime vars
APP_URL=http://localhost:3002
DEBUG_PORT=9222
REUSE_BROWSER=0
