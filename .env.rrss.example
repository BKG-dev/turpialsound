# Turpial Sound — RRSS Bot Environment
# Copy this to .env.rrss.local (gitignored) and fill in your secrets.
# NEVER commit .env.rrss.local to the repository.

# Mode: dry-run (safe, no real posts) | live (real publishing)
RRSS_MODE=dry-run

# Require human approval before publish-live
RRSS_REQUIRE_APPROVAL=true

# Local dashboard port
RRSS_REVIEW_PORT=4877

# Allowed channels (comma-separated)
RRSS_ALLOWED_CHANNELS=facebook,instagram

# Timezone
RRSS_TIMEZONE=America/Caracas

# Brand
RRSS_BRAND_NAME=Turpial Sound

# === META CREDENTIALS (secret — NEVER commit) ===
# Fill these only in .env.rrss.local

# Meta Developer App
META_APP_ID=
META_APP_SECRET=

# Access Token (User or Page)
META_ACCESS_TOKEN=

# Facebook Page
META_PAGE_ID=

# Instagram (connected to Page)
META_IG_USER_ID=

# === OPTIONAL ===

# Public base URL for media assets (required for Instagram publish-live)
RRSS_PUBLIC_ASSET_BASE_URL=

# Dry run output directory
RRSS_DRY_RUN_OUTPUT_DIR=data/rrss/drafts

# Logs directory
RRSS_LOG_DIR=data/rrss/logs

# === FUTURE (not active in this sprint) ===

# Webhook verify token for messaging
WEBHOOK_VERIFY_TOKEN=

# Webhook callback URL
WEBHOOK_CALLBACK_URL=
